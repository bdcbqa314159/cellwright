# EditorConfig — baseline for editors not running clangd. C++ formatting lives in
# .clang-format; this covers indent/charset/newlines everywhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # markdown line breaks are two trailing spaces

[Makefile]
indent_style = tab
